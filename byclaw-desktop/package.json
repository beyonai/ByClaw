{
  "name": "byclaw-desktop",
  "version": "0.1.0",
  "description": "ByClaw 桌面端 —— 完整门户 + 本地 Agent（跨平台）",
  "main": "main.mjs",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "start": "electron .",
    "worker": "node worker/worker-launcher.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "deploy": "node scripts/deploy-local.mjs",
    "dist": "node scripts/build-renderer.mjs && electron-builder",
    "dist:linux": "node scripts/build-renderer.mjs && electron-builder --linux",
    "dist:win": "node scripts/build-renderer.mjs && electron-builder --win",
    "dist:mac": "node scripts/build-renderer.mjs && electron-builder --mac"
  },
  "dependencies": {
    "http-proxy": "1.18.1",
    "openclaw": "2026.6.6"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "openclaw",
      "tree-sitter-bash"
    ]
  },
  "build": {
    "appId": "com.byclaw.desktop",
    "productName": "ByClaw",
    "files": [
      "main.mjs",
      "preload.cjs",
      "lib/**/*",
      "worker/**/*",
      "renderer/**/*",
      "!node_modules/openclaw/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "beyonai",
      "repo": "ByClaw"
    }
  }
}
