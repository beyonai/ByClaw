{
  // by-datacloud 与 byclaw-all 同级时用 ../by-datacloud；若仓库层级不同，请改为 ../../by-datacloud 等
  "version": "0.2.0",
  "configurations": [

    {
      // ── 源码调试模式 ──────────────────────────────────────────────────────
      // PYTHONPATH 只把 by-datacloud 源码目录排在最前，覆盖 venv 里的已安装包，
      // 可在 by-datacloud 源仓库直接打断点。
      // by-framework / by-framework-trace-langfuse 通过 uv.sources 本地路径安装，
      // 不需要再手动加入 PYTHONPATH。
      "name": "byclaw-data-worker [源码调试]",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/byclaw-data/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/byclaw-data/src/byclaw_data/main.py",
      "cwd": "${workspaceFolder}/byclaw-data",
      "envFile": "${workspaceFolder}/byclaw-data/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/byclaw-data/src;${workspaceFolder}/../by-datacloud/packages/datacloud-platform/src;${workspaceFolder}/../by-datacloud/packages/datacloud-analysis/src;${workspaceFolder}/../by-datacloud/packages/datacloud-data/src;${workspaceFolder}/../by-datacloud/packages/datacloud-knowledge/src;${env:PYTHONPATH}",
      },
      "justMyCode": false
    },
    {
      "name": "byclaw-data-service [source debug 8088]",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/byclaw-data/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/byclaw-data/src/byclaw_data/platform/main.py",
      "cwd": "${workspaceFolder}/byclaw-data",
      "envFile": "${workspaceFolder}/byclaw-data/.env2",
      "env": {
        "DATACLOUD_DATA_SERVICE_HOST": "0.0.0.0",
        "DATACLOUD_DATA_SERVICE_PORT": "8088",
        "PYTHONPATH": "${workspaceFolder}/byclaw-data/src;${workspaceFolder}/../by-datacloud/packages/datacloud-platform/src;${workspaceFolder}/../by-datacloud/packages/datacloud-analysis/src;${workspaceFolder}/../by-datacloud/packages/datacloud-data/src;${workspaceFolder}/../by-datacloud/packages/datacloud-knowledge/src;${env:PYTHONPATH}",
      },
      "justMyCode": false
    }
  ]
}
