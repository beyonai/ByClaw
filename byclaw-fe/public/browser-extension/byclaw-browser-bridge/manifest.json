{
  "manifest_version": 3,
  "name": "ByClaw Browser Bridge",
  "description": "Bridge signed-in browser tabs to ByClaw conversation collection tasks.",
  "version": "0.3.0",
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ByClaw Browser Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability-lite.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": ["activeTab", "scripting", "storage", "tabs"]
}
