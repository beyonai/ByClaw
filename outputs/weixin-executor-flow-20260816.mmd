flowchart TD
  A["用户请求"] --> B["预检：doctor、daemon、持久浏览器标签页"]
  B --> C{"意图与输入类型"}

  C -->|"没有账号历史或文章主题线索的裸短语"| C0["只询问一次：查公众号历史，还是查文章主题？"]
  C0 --> C
  C -->|"明确的账号身份或账号历史"| D["执行 accounts 查询"]
  C -->|"明确的文章标题或主题"| E["执行 sougousearch 查询"]
  C -->|"直接 URL、fakeid、草稿、合集或发布数据"| F["执行对应命令"]

  D --> G{"账号发现结果"}
  G -->|"一个精确匹配"| H["证明 nickname ↔ fakeid 唯一绑定"]
  G -->|"多个精确匹配"| I["依次预览候选账号，由用户选择"]
  G -->|"有记录但没有精确匹配"| J["返回最多三个模糊建议并终止"]
  G -->|"EMPTY_RESULT 或类型化错误"| T0

  I --> K{"选中昵称是否仍然重复？"}
  K -->|"是"| L["仅走后端；省略 --name"]
  K -->|"否，且唯一绑定已验证"| H

  H --> M["使用已验证的 --name 执行 articles/save-articles"]
  L --> N["仅用 fakeid 执行 articles/save-articles"]
  M --> O{"主后端结果"}
  N --> O
  O -->|"成功"| R["返回结构化记录或可读文件"]
  O -->|"符合条件的 COMMAND_EXEC/EMPTY_RESULT，且名称已验证"| P["由适配器内部执行搜狗回退"]
  O -->|"其他非成功结果"| T0
  P --> W{"内部回退结果"}
  W -->|"成功"| R
  W -->|"非成功"| T0

  E --> Q{"公开搜索结果"}
  Q -->|"有结果"| S["用户选择结果；需要正文时再执行 download"]
  Q -->|"EMPTY_RESULT 或类型化错误"| T0
  S --> R

  F --> U{"命令结果"}
  U -->|"成功"| R
  U -->|"非成功"| T0

  subgraph T["终态优先级：从上到下，第一个匹配规则生效"]
    T0{"诊断重试已执行，或诊断重试预算已使用？"}
    T0 -->|"是"| T1["保留结果、产物、错误和 trace；终止，不再重试"]
    T0 -->|"否"| T2{"登录确认后的单次重跑是否再次返回认证或验证错误？"}
    T2 -->|"是"| T3["保留浏览器上下文并报告准确的认证结果；终止，不再确认或重跑"]
    T2 -->|"否"| T4{"AUTH_REQUIRED、登录 TIMEOUT、CAPTCHA 或环境验证？"}
    T4 -->|"是"| T5["冻结上下文；等待用户明确确认登录完成"]
    T4 -->|"否"| T6{"公开回退所需昵称缺失、未验证、不匹配或有歧义？"}
    T6 -->|"是"| T7["澄清并用 accounts 验证，或保持仅后端模式"]
    T6 -->|"否"| T8{"是否为有效的最终 EMPTY_RESULT？"}
    T8 -->|"是"| T9["报告无结果；不进入 AutoFix"]
    T8 -->|"否"| T10{"发布数据行是否为 partial 或 failed？"}
    T10 -->|"是"| T11["保留状态、错误和可读产物；终止"]
    T10 -->|"否"| T12{"是否为非登录的顶层发布数据 TIMEOUT，且无记录、无产物、诊断预算未使用？"}
    T12 -->|"是"| T13["请求用户批准一次带 trace 的诊断重试"]
    T12 -->|"否"| T14["按类型化错误映射处理；仅在允许时进入 AutoFix"]
    T13 -->|"拒绝或未批准"| T15["报告原始超时并终止"]
    T13 -->|"批准"| T16["启动前消耗诊断预算；保持原查询与参数，只重试一次"]
  end

  T5 --> V["启动前消耗登录重跑预算；原命令只重跑一次"]
  V --> V0{"登录重跑结果"}
  V0 -->|"成功"| R
  V0 -->|"非成功"| T0

  T16 --> X{"诊断重试结果"}
  X -->|"成功"| R
  X -->|"非成功"| T0
