{
  "name": "@openclaw/byclaw-sqlite",
  "version": "2026.4.23",
  "private": true,
  "description": "OpenClaw dev plugin that exposes a SQLite-backed sqlExecute capability for the byclaw database.",
  "type": "module",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --sourcemap --packages=external --external:openclaw",
    "build:fast": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --packages=external --external:openclaw",
    "test": "tsx --test src/config.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.22.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.16",
      "minGatewayVersion": ">=2026.4.16"
    },
    "build": {
      "openclawVersion": "2026.4.16",
      "pluginSdkVersion": "2026.4.16"
    }
  }
}
