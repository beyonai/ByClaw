{
  "name": "@byclaw/byclaw-model-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./dsh": {
      "types": "./src/dsh.d.ts",
      "default": "./src/dsh.js"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify:dsh": "node scripts/dsh-verify.mjs"
  },
  "dependencies": {
    "@byclaw/jev-client": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  }
}
