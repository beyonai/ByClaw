{
  "name": "@zhchxiao123/dsh-devflow-command",
  "description": "Human-facing /devflow intervention command over the devflow task-card seam",
  "version": "0.4.0-dev.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhchxiao123/dsh-devflow-plugins.git",
    "directory": "packages/devflow-command"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@zhchxiao123/dsh-devflow": "workspace:^",
    "@zhchxiao123/dsh-devflow-spec": "workspace:^",
    "@zhchxiao123/dsh-devflow-spec-sentinel": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@zhchxiao123/dsh-devflow": "workspace:^",
    "@zhchxiao123/dsh-devflow-filesystem": "workspace:^",
    "@zhchxiao123/dsh-devflow-spec": "workspace:^",
    "@zhchxiao123/dsh-devflow-spec-filesystem": "workspace:^",
    "@zhchxiao123/dsh-devflow-spec-sentinel": "workspace:^"
  },
  "scripts": {
    "prepublishOnly": "node -e \"for (const f of require('./package.json').files.filter(f=>!f.includes('*'))) if (!require('node:fs').existsSync(f)) { console.error('prepublishOnly: '+f+' is missing; run pnpm run build at the repo root'); process.exit(1) }\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@zhchxiao123/dsh-devflow-worktree": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zhchxiao123/dsh-devflow-spec": {
      "optional": true
    },
    "@zhchxiao123/dsh-devflow-spec-sentinel": {
      "optional": true
    }
  }
}
