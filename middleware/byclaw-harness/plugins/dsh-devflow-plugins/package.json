{
  "name": "@zhchxiao123/dsh-devflow-plugins",
  "version": "0.4.0-dev.8",
  "private": true,
  "type": "module",
  "description": "devflow for DeepSeek Harness: a standalone plugin line over the ctx.devflow capability seam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhchxiao123/dsh-devflow-plugins.git"
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "init": "bash scripts/init.sh",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm run clean && tsc -b tsconfig.json && tsdown && tsdown --config tsdown.client.ts",
    "clean": "tsx scripts/clean.ts",
    "lint": "oxlint .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "build:types": "tsc -b tsconfig.json",
    "build:client": "tsdown --config tsdown.client.ts",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:tarballs": "tsx scripts/preflight.ts --no-registry",
    "release": "pnpm run verify && pnpm run build && pnpm run preflight && pnpm publish -r --access public",
    "set-version": "tsx scripts/set-version.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "eslint-plugin-sonarjs": "4.2.0",
    "jsdom": "29.1.1",
    "lightningcss": "1.33.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@shikijs/langs": "4.4.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.2",
    "@types/js-yaml": "4.0.9",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "immer": "10.2.0",
    "katex": "0.18.7",
    "js-yaml": "4.2.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "shiki": "4.4.3",
    "zustand": "4.4.7",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "diff": "9.0.0",
    "simple-icons": "16.31.0"
  },
  "dependencies": {
    "@zhchxiao123/dsh-devflow-bundle": "workspace:^",
    "@zhchxiao123/dsh-devflow-testenv": "workspace:^"
  },
  "packageManager": "pnpm@11.28.5"
}
