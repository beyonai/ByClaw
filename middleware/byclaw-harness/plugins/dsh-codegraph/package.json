{
  "name": "@byclaw/dsh-codegraph",
  "version": "0.1.0",
  "description": "CodeGraph MCP composition and model guidance for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm build && pnpm run verify:contract && pnpm run verify:runtime-fixtures",
    "verify:contract": "node scripts/verify.mjs",
    "verify:runtime": "node scripts/verify.mjs --runtime",
    "verify:runtime-fixtures": "node scripts/verify-runtime-fixtures.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-mcp-client": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@types/node": "24.13.3",
    "js-yaml": "4.2.0",
    "typescript": "5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "codegraph": {
      "version": "1.6.0",
      "mcpTools": [
        "codegraph_explore"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korvo873/byclaw-dsh.git",
    "directory": "plugins/dsh-codegraph"
  }
}
