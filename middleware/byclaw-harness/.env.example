# Shared ByClaw identity. Required when byclaw-integration is enabled unless
# config.userCode supplies it directly.
USER_CODE=replace-with-byclaw-user-code

# Optional fixed token for the DSH Web root exchange; inject at runtime in containers.
# BYCLAW_DSH_WEB_AUTH_TOKEN=replace-with-web-launch-token
# Set false to disable DSH Web token/cookie authentication; Host/Origin checks remain active.
# BYCLAW_DSH_WEB_AUTH_ENABLED=true
# BYCLAW_DSH_PROJECTION_CONCURRENCY=8

# Busy Enter delivery: queue = 排队发送, steer = 插话发送.
# A saved UI preference takes precedence; restart DSH after changing this value.
BYCLAW_DSH_BUSY_ENTER=queue

# Busy Enter delivery: queue = 排队发送, steer = 插话发送.
# A saved UI preference takes precedence; restart DSH after changing this value.
BYCLAW_DSH_BUSY_ENTER=queue

# Redis standalone connection used by @byclaw/by-framework.
REDIS_MODE=standalone
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password
REDIS_DATABASE=0

# Sandbox idle reporting (@byclaw/dsh-idle-reporter) appends busy/releasable
# snapshots to this Stream over the Redis connection above. A sandbox is
# releasable after this many milliseconds without work.
# BYCLAW_DSH_ACTIVITY_STREAM=byclaw:dsh:sandbox:activity
# BYCLAW_DSH_IDLE_TIMEOUT_MS=1800000

# Redis Cluster alternative. When enabled, comment out the standalone values
# above, set REDIS_MODE=cluster, and provide every seed as host:port.
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=redis-1.example.com:6379,redis-2.example.com:6379
# REDIS_KEY_SCHEMA_VERSION=v2

# Redis-backed ByClaw model configuration is enabled by default. Set this to false only
# when byclaw-dsh.config provides both provider and model.
BYCLAW_REDIS_MODEL_ENABLED=true

# Required by Redis dynamic-model mode. Supply the deployment's SM4 key as
# hexadecimal text; never commit the real value.
BAIYING_AIMODEL_AUTH_TOKEN_SM4_KEY_HEX=replace-with-sm4-key-hex

# Optional dynamic-model idle timeout in seconds. The runtime default is 600.
BYCLAW_LLM_IDLE_TIME=600

# Shared Jev connection through Vercel AI Gateway (TypeSafe-compatible API).
# Supply a Vercel key here, or through AI_GATEWAY_API_KEY. Never commit real keys.
BYCLAW_JEV_API_KEY=
BYCLAW_JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
BYCLAW_JEV_MODEL=typesafe-ai/jev
BYCLAW_JEV_TIMEOUT_MS=15000

# Intent -> agent / expert group. Restart the Worker after changing switches.
BYCLAW_AGENT_ROUTER_ENABLED=false

# Intent -> model. The agent-configured model remains the first failure fallback.
# Use this repository's compatibility runtime build (DSH 0.1.5-rc.2).
# An unpatched runtime is rejected at startup when model routing is enabled.
BYCLAW_MODEL_ROUTER_ENABLED=false
# Comma-separated Redis model instance IDs permitted as automatic alternatives.
BYCLAW_MODEL_ROUTER_MODEL_IDS=
BYCLAW_MODEL_ROUTER_MIN_CONFIDENCE=0.7
BYCLAW_MODEL_ROUTER_MAX_RESELECTS=2
BYCLAW_MODEL_ROUTER_RECOVERY_BUDGET_MS=30000

# Browser goals -> Jev. Independent from agent/model router flags; restart Worker + browserd.
BYCLAW_BROWSER_JEV_ENABLED=false
# Input-field text reuses the calling session's actual model. No separate model configuration.
# Optional budgets; runGoal may lower, but never raise, these limits.
BYCLAW_BROWSER_GOAL_MAX_STEPS=40
BYCLAW_BROWSER_GOAL_MAX_DECISIONS=80
BYCLAW_BROWSER_GOAL_TIMEOUT_MS=180000
BYCLAW_BROWSER_GOAL_PAUSE_TIMEOUT_MS=120000
BYCLAW_BROWSER_GOAL_QUEUE_TIMEOUT_MS=10000
BYCLAW_BROWSER_GOAL_MAX_TEXT_CALLS=12
BYCLAW_BROWSER_JEV_MIN_CONFIDENCE=0.5
# Worker and managed byCLI launcher must share this lock path and Unix user.
# BYCLAW_BROWSER_AUTOMATION_LOCK=/run/byclaw-browser/automation.lock
# Persist goal downloads outside lease cleanup; default is <Worker cwd>/.byclaw-browser-artifacts.
# BYCLAW_BROWSER_GOAL_ARTIFACT_DIR=/workspace/browser-artifacts
