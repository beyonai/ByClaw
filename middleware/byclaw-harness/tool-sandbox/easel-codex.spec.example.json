{
  "image": "byclaw-acr-registry-vpc.cn-beijing.cr.aliyuncs.com/byclaw/byclaw-harness:D0.6.0_easel-codex-20261109-r2",
  "startup": {
    "entrypoint": [
      "/usr/local/bin/byclaw-easel-codex-entrypoint",
      "tools"
    ]
  },
  "env": {
    "TZ": "Asia/Shanghai",
    "USER_CODE": "${USER_CODE}",
    "BYCLAW_TOOL_ENV_PORT": "2222",
    "BYCLAW_TOOL_ENV_WS_PORT": "8080",
    "BYCLAW_TOOL_ENV_HOST_KEY": "${envVars.BYCLAW_TOOL_ENV_HOST_KEY}",
    "BYCLAW_TOOL_ENV_AUTHORIZED_KEY": "${envVars.BYCLAW_TOOL_ENV_AUTHORIZED_KEY}",
    "BYCLAW_BROWSER_STARTUP": "eager",
    "EASEL_AGENT_RUNTIME": "codex",
    "CODEX_HOME": "/by/.codex",
    "BYCLAW_EASEL_SOURCE_COMMIT": "5c12e42e9019d276368130b52385b770749ffa6f"
  },
  "servicePort": 8080,
  "ports": [
    {
      "port": 8080,
      "instance": "ssh",
      "protocol": "http",
      "exposure": "private"
    },
    {
      "port": 8081,
      "instance": "vnc",
      "protocol": "http",
      "exposure": "public"
    }
  ],
  "resourceRequests": {
    "cpu": "2",
    "memory": "4Gi"
  },
  "resourceLimits": {
    "cpu": "4",
    "memory": "8Gi"
  },
  "timeout": 1800,
  "volumes": [
    {
      "key": "base",
      "type": "persistent",
      "scope": "PRIVATE",
      "subPath": "byclaw-${user_code}/by",
      "mountPath": "/by",
      "volumeRef": "workspace",
      "readOnly": false
    }
  ],
  "runtimeOptions": {
    "lifecycle": {
      "autoStart": "false"
    },
    "toolSandbox": {
      "contract": "byclaw.tool-sandbox/v1",
      "templateKey": "easel-codex",
      "purpose": "easel-codex",
      "enabled": "true",
      "imageTag": "D0.6.0_easel-codex-20261109-r2",
      "description": "包含 Easel 完整源码、Codex CLI、Python/Node、FFmpeg、Playwright 和 Remotion；用于在 ByClaw 内调试、运行及验收 Easel。",
      "capabilities": "[\"process.exec\",\"filesystem\",\"software.development\",\"media.render\",\"browser.automation\",\"agent.codex\"]",
      "operations": "{\"protocol\":\"ssh\",\"exposure\":\"private\"}",
      "display": "{\"available\":true,\"defaultExposure\":\"public\",\"auth\":\"byclaw-session\"}"
    }
  }
}
