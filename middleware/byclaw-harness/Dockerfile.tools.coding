# Build from the ByClaw repository root. Codex only; keep browser/SSH transport.
ARG BROWSER_IMAGE=192.168.0.81:8080/byclaw/byclaw-harness-tools:D0.6.0_browser
FROM ${BROWSER_IMAGE} AS coding-core
USER root
ARG TARGETARCH
RUN test "${TARGETARCH}" = amd64
ENV CODEX_HOME=/home/byclaw/.codex \
    BYCLAW_SKILLS_DIR=/opt/byclaw/builtin/skills \
    BYCLAW_AGENT_SKILLS_PREPARER=/usr/local/lib/byclaw/agent-skills/scripts/prepare-agent-skills.mjs

COPY middleware/byclaw-harness/tool-sandbox/configure-cn-sources.sh /tmp/configure-cn-sources.sh
COPY middleware/byclaw-harness/tool-sandbox/codex.release.json /tmp/codex.release.json
COPY middleware/byclaw-harness/scripts/install-codex.py /tmp/install-codex.py
RUN set -eu; \
    bash /tmp/configure-cn-sources.sh; \
    apt-get -o APT::Update::Error-Mode=any update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nginx openssh-client; \
    rm -rf /var/lib/apt/lists/*; \
    python3 /tmp/install-codex.py --release /tmp/codex.release.json --prefix /opt/byclaw/codex; \
    ln -s /opt/byclaw/codex/bin/codex /usr/local/bin/codex; \
    install -d /usr/local/share/byclaw-tool-sandbox; \
    cp /tmp/codex.release.json /usr/local/share/byclaw-tool-sandbox/codex.release.json; \
    rm /tmp/install-codex.py /tmp/codex.release.json /tmp/configure-cn-sources.sh

RUN install -d -m 0700 -o byclaw -g byclaw "${CODEX_HOME}"
COPY --chown=byclaw:byclaw --chmod=0600 middleware/byclaw-harness/tool-sandbox/codex.config.toml /home/byclaw/.codex/config.toml
COPY --chown=byclaw:byclaw middleware/builtin/skills/ /opt/byclaw/builtin/skills/
COPY --chown=byclaw:byclaw middleware/builtin/python-clis/ /opt/byclaw/builtin/python-clis/
COPY --chmod=0755 middleware/builtin/runtime-tools/server-ssh.py /usr/local/bin/server-ssh
RUN python3 -m pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
      "by-framework==0.2.2.dev10" \
      /opt/byclaw/builtin/python-clis/kbcli \
      /opt/byclaw/builtin/python-clis/groksearchcli \
      /opt/byclaw/builtin/python-clis/callcli \
      "/opt/byclaw/builtin/python-clis/dbcli[all]" \
    && python3 -m pip check \
    && python3 -c 'from by_framework.core.discovery import DiscoveryClient' \
    && python3 "${BYCLAW_SKILLS_DIR}/by-knowledge-manager/scripts/by_knowledge_manager.py" --help >/dev/null \
    && kbcli --help >/dev/null && groksearchcli --help >/dev/null \
    && callcli --help >/dev/null && dbcli --help >/dev/null
COPY middleware/byclaw-harness/plugins/byclaw-integration/scripts/prepare-agent-skills.mjs /usr/local/lib/byclaw/agent-skills/scripts/prepare-agent-skills.mjs
COPY middleware/byclaw-harness/plugins/byclaw-integration/src/skill-sync.ts middleware/byclaw-harness/plugins/byclaw-integration/src/generation-paths.ts /usr/local/lib/byclaw/agent-skills/src/
RUN npm install --prefix /usr/local/lib/byclaw/agent-skills --registry=https://registry.npmmirror.com \
      --ignore-scripts --no-audit --no-fund --save-exact js-yaml@4.2.0 \
    && test -s "${BYCLAW_SKILLS_DIR}/skill-creator/SKILL.md" \
    && node --experimental-transform-types --input-type=module -e 'await import(process.env.BYCLAW_AGENT_SKILLS_PREPARER)' \
    && rm -rf /root/.npm
COPY middleware/byclaw-harness/tool-sandbox/coding.capabilities.json /etc/byclaw-tool-sandbox/capabilities.json
COPY --chmod=0755 middleware/byclaw-harness/scripts/sandbox-app.py /usr/local/bin/sandbox-app
COPY --chmod=0755 middleware/byclaw-harness/scripts/sandbox-template.py /usr/local/bin/sandbox-template
COPY --chmod=0755 middleware/byclaw-harness/scripts/coding-entrypoint.py /usr/local/bin/byclaw-coding-entrypoint
COPY middleware/byclaw-harness/tool-sandbox/APP_PREVIEW.md /etc/byclaw-tool-sandbox/APP_PREVIEW.md
RUN set -eu; \
    su -s /bin/sh byclaw -c 'codex --version'; \
    env | grep -vE '^(HOSTNAME|HOME|PWD|OLDPWD|SHLVL|_)=' >/etc/byclaw-tool-env.session-env; \
    chmod 0644 /etc/byclaw-tool-env.session-env
RUN python3 -m py_compile /usr/local/bin/sandbox-app /usr/local/bin/sandbox-template /usr/local/bin/byclaw-coding-entrypoint /usr/local/bin/server-ssh \
    && ssh -V && command -v scp && server-ssh --help >/dev/null \
    && nginx -V \
    && ln -sfn /usr/local/bin/byclaw-coding-entrypoint /usr/local/bin/byclaw-dsh-entrypoint

LABEL io.byclaw.tool-sandbox.contract="byclaw.tool-sandbox/v1" \
      io.byclaw.tool-sandbox.purpose="coding"
# Prepare Nginx, then delegate to the original SSH/browser entrypoint.
EXPOSE 8082
ENTRYPOINT ["/usr/local/bin/byclaw-coding-entrypoint"]
CMD ["tools"]

# Bundled applications are initialized explicitly, never during sandbox startup.
# --target coding-core omits the transitional preinstalled media environment.
FROM coding-core AS tools-coding
COPY middleware/byclaw-harness/templates/easel/ /opt/byclaw/templates/easel/
RUN bash /opt/byclaw/templates/easel/install.sh
