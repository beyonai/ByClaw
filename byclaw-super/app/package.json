{
  "name": "@byclaw/byclaw-super",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant super assistant service built on by-conductor",
  "scripts": {
    "dev": "tsx index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@byclaw/by-conductor": "workspace:*",
    "@byclaw/connector-openclaw-by-framework": "workspace:*",
    "@fastify/cors": "11.3.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0"
  }
}
