# Choose a model registered by Pi. Both values are optional; when omitted,
# the first model with valid credentials is selected.
PI_PROVIDER=zhipu
PI_MODEL=glm-5.2

# The Zhipu OpenAI-compatible provider reuses this key variable.
# Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# ANTHROPIC_API_KEY=

HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*
