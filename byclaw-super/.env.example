# 基础设施连接没有代码默认值；缺少任一必填项时应用会拒绝启动。

# PostgreSQL
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_SCHEMA=
DB_USER=
DB_PASS=
DB_SSL=

# Redis：standalone 模式填写 REDIS_HOST/REDIS_PORT；
# cluster 模式填写 REDIS_CLUSTER_HOST（逗号分隔 host:port）。
REDIS_MODE=
REDIS_HOST=
REDIS_PORT=
# REDIS_CLUSTER_HOST=
REDIS_DATABASE=
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Redis 默认 LLM 读取失败时使用的 DeepSeek/火山方舟兜底配置。
# PI_PROVIDER=volcengine-ark
# PI_MODEL=deepseek-v4-pro-260425
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=

# 常见部署差异；不配置时使用 app/config-defaults.ts 中的值。
# PORT=3000
# 标准 PostgreSQL 默认 true；不支持 LISTEN 的兼容数据库设为 false。
# DB_EVENT_LISTEN_ENABLED=false
# 生产通常由独立 release job 执行迁移。
# DB_MIGRATE_ON_START=false

# ByClaw BE 与 by-framework Worker。专家团运行时会携带当前用户 Beyond-Token
# 回调 BYCLAW_BE_BASE_URL 下的 /byaiService/internal/v1/orchestrators/resolve-runtime。
# BYCLAW_BE_BASE_URL=http://127.0.0.1:8086
# BYCLAW_BE_TIMEOUT_MS=10000
# LOGIN_JWT_PUBLIC_KEY=需与 byclaw-be 登录 JWT 公钥一致
# BYCLAW_WORKER_ENABLED=true
# BYCLAW_WORKER_AGENT_TYPE=BY_SUPER
# BYCLAW_WORKER_MAX_CONCURRENCY=10

# `pnpm smoke:expert-team` 仅用于本地/联调环境；BEYOND_TOKEN 和 EXPERT_TEAM_ID
# 必须在执行时注入，不要写入或提交到 .env。
# SMOKE_TIMEOUT_MS=600000
# SMOKE_MESSAGE=请让团队成员协作完成一个简单任务

# 三方数字员工根据 discoverMine 返回的 createType 和 integrationType 自动选择直连协议。
# THIRD_PARTY_AGENT_DESCRIPTOR_PATH=/byaiService/api/internal/v1/digital-employees
# THIRD_PARTY_AGENT_SERVICE_CREDENTIAL=
# THIRD_PARTY_AGENT_REQUEST_TIMEOUT_MS=300000

# event-stream Connector 的首次活动与无活动空闲超时；可信活动会持续续期。
DELEGATION_FIRST_ACTIVITY_TIMEOUT_MS=300000
DELEGATION_IDLE_TIMEOUT_MS=900000
# callAgent 受理后等待终态 ResumeCommand 的绝对时限；不由子 Agent DataStream 续期。
DELEGATION_CALLBACK_TIMEOUT_MS=300000
OPENCLAW_CANCEL_CONFIRM_TIMEOUT_MS=30000
# 仅开发环境可开启；生产三方 endpoint 应使用 HTTPS。
# THIRD_PARTY_AGENT_ALLOW_INSECURE_HTTP=false
# 配置后只允许这些三方 endpoint host，逗号分隔。
# THIRD_PARTY_AGENT_ALLOWED_HOSTS=vendor.example.com

# 其余可选覆盖项示例：
# HOST=0.0.0.0
# CORS_ORIGIN=*
# LOG_LEVEL=info
# 首次回填能力卡时，源员工表不在 DB_SCHEMA 可单独指定。
# BYCLAW_SOURCE_SCHEMA=byai
# 源员工表位于另一数据库实例时，可单独覆盖连接；未配置项回退到 DB_*。
# BYCLAW_SOURCE_DB_HOST=127.0.0.1
# BYCLAW_SOURCE_DB_PORT=5432
# BYCLAW_SOURCE_DB_DATABASE=postgres
# BYCLAW_SOURCE_DB_USER=
# BYCLAW_SOURCE_DB_PASS=
# BYCLAW_SOURCE_DB_SSL=false
# DB_POOL_MAX=20
# RUN_LEASE_MS=30000
# RUN_QUEUE_POLL_MS=500
# PI_SESSION_CACHE_MAX_ENTRIES=100
# PI_SESSION_CACHE_IDLE_TTL_MS=1800000
