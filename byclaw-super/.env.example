HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*
LOG_LEVEL=info

DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_SCHEMA=byai
DB_USER=
DB_PASS=
DB_SSL=false
# Standard PostgreSQL: true. Set false only for compatible databases without LISTEN.
DB_EVENT_LISTEN_ENABLED=true
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
# Production should run migrations as a separate release job.
DB_MIGRATE_ON_START=false

RUN_LEASE_MS=30000
RUN_QUEUE_POLL_MS=500
RUN_CREDENTIAL_MAX_TTL_MS=7200000
RUN_CREDENTIAL_CLEANUP_INTERVAL_MS=60000
# Must be unique for every concurrently running process; defaults to hostname + pid.
# BYCLAW_INSTANCE_ID=
# PI_SESSION_CACHE_DIR=
PI_SESSION_CACHE_MAX_ENTRIES=100
PI_SESSION_CACHE_IDLE_TTL_MS=1800000
PI_ENTRY_MAX_BYTES=1048576
PI_SESSION_MAX_BYTES=16777216
PI_SESSION_MAX_ENTRIES=20000

# Adapter module must export createKeyEncryptionService({ keyId }).
# Use workload identity/instance role inside the adapter; do not put cloud secrets here.
# macOS local only: ./keychain-kms-adapter.js (requires NODE_ENV != production).
KMS_ADAPTER_MODULE=
KMS_KEY_ID=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_KEY_SCHEMA_VERSION=v1

DELEGATION_TIMEOUT_MS=1800000

# Register byclaw-super as a by-framework Worker by default.
BYCLAW_WORKER_ENABLED=true
BYCLAW_WORKER_AGENT_TYPE=BY_SUPER
# Optional unique instance ID; defaults to byclaw-super-{hostname}.
# BYCLAW_WORKER_ID=
BYCLAW_WORKER_MAX_CONCURRENCY=10

# Beyond-Token uses the same RS256 login JWT public key as ByClaw BE by default.
# Override this when the parent ByClaw deployment uses a non-default login.jwt.public-Key.
# LOGIN_JWT_PUBLIC_KEY=

# Fallback ByClaw BE origin when Redis has no valid ByaiService instance.
BYCLAW_BE_BASE_URL=http://127.0.0.1:8086
BYCLAW_BE_TIMEOUT_MS=10000

PI_PROVIDER=zhipu
PI_MODEL=glm-5.2
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_API_KEY=
