# 稳定默认值集中在 app/config-defaults.ts；同名环境变量可覆盖它们。
# 这里只保留启动必填项和部署时最常见的差异项。

# PostgreSQL 是唯一生产存储。账号和密码不提供代码默认值。
DB_USER=
DB_PASS=

# 默认 Pi 模型是 zhipu/glm-5.2。
OPENAI_API_KEY=

# 常见部署差异；不配置时使用 app/config-defaults.ts 中的值。
# PORT=3000
# REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
# REDIS_PASSWORD=
# 标准 PostgreSQL 默认 true；不支持 LISTEN 的兼容数据库设为 false。
# DB_EVENT_LISTEN_ENABLED=false
# 生产通常由独立 release job 执行迁移。
# DB_MIGRATE_ON_START=false

# 三方数字员工直连默认关闭；allowlist 仅切指定 resourceId，all 切全部已识别三方员工。
# THIRD_PARTY_AGENT_DIRECT_MODE=off
# THIRD_PARTY_AGENT_ALLOWLIST=1001,1002
# THIRD_PARTY_AGENT_DESCRIPTOR_PATH=/byaiService/api/internal/v1/digital-employees
# THIRD_PARTY_AGENT_SERVICE_CREDENTIAL=
# THIRD_PARTY_AGENT_REQUEST_TIMEOUT_MS=300000
# 仅开发环境可开启；生产三方 endpoint 应使用 HTTPS。
# THIRD_PARTY_AGENT_ALLOW_INSECURE_HTTP=false
# 配置后只允许这些三方 endpoint host，逗号分隔。
# THIRD_PARTY_AGENT_ALLOWED_HOSTS=vendor.example.com

# 其余可选覆盖项示例：
# HOST=0.0.0.0
# CORS_ORIGIN=*
# LOG_LEVEL=info
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_SCHEMA=byai
# 首次回填能力卡时，源员工表不在 DB_SCHEMA 可单独指定。
# BYCLAW_SOURCE_SCHEMA=byai
# 源员工表位于另一数据库实例时，可单独覆盖连接；未配置项回退到 DB_*。
# BYCLAW_SOURCE_DB_HOST=127.0.0.1
# BYCLAW_SOURCE_DB_PORT=5432
# BYCLAW_SOURCE_DB_DATABASE=postgres
# BYCLAW_SOURCE_DB_USER=
# BYCLAW_SOURCE_DB_PASS=
# BYCLAW_SOURCE_DB_SSL=false
# DB_SSL=false
# DB_POOL_MAX=20
# RUN_LEASE_MS=30000
# RUN_QUEUE_POLL_MS=500
# PI_SESSION_CACHE_MAX_ENTRIES=100
# PI_SESSION_CACHE_IDLE_TTL_MS=1800000
# PI_PROVIDER=zhipu
# PI_MODEL=glm-5.2
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
