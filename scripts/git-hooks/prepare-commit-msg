#!/bin/bash
# ============================================================
# prepare-commit-msg hook — datacloud 分支合并约束
#
# 入方向: datacloud 只接受 develop 的合并
# 出方向: datacloud 只能被 develop 合并
# ============================================================

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# 仅合并操作
if [ "$COMMIT_SOURCE" != "merge" ]; then
    exit 0
fi

# 确认 MERGE_HEAD
if [ ! -f ".git/MERGE_HEAD" ]; then
    exit 0
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
MERGE_HEAD=$(cat .git/MERGE_HEAD)
DATACLOUD_HEAD=$(git rev-parse refs/heads/datacloud 2>/dev/null)
DEVELOP_HEAD=$(git rev-parse refs/heads/develop 2>/dev/null)

# 判断 MERGE_HEAD 是否属于 datacloud
is_from_datacloud() {
    [ "$MERGE_HEAD" = "$DATACLOUD_HEAD" ] && return 0
    git merge-base --is-ancestor "$MERGE_HEAD" "refs/heads/datacloud" 2>/dev/null
}

# 判断 MERGE_HEAD 是否属于 develop
is_from_develop() {
    [ "$MERGE_HEAD" = "$DEVELOP_HEAD" ] && return 0
    git merge-base --is-ancestor "$MERGE_HEAD" "refs/heads/develop" 2>/dev/null
}

# ── 约束1: 在 datacloud 上合并 → 来源必须是 develop ──
if [ "$CURRENT_BRANCH" = "datacloud" ]; then
    if is_from_develop; then
        exit 0
    fi
    cat <<EOF >&2

╔══════════════════════════════════════════════════════════╗
║  ⛔  合并被拒绝  —  datacloud 入向保护                  ║
╠══════════════════════════════════════════════════════════╣
║                                                        ║
║  datacloud 分支只接受来自 develop 分支的合并。          ║
║  当前合并来源不属于 develop 的提交历史。                ║
║                                                        ║
║  ✅ 正确的操作:                                         ║
║     git merge develop                                  ║
║                                                        ║
║  ↩️  撤销: git merge --abort                            ║
║                                                        ║
╚══════════════════════════════════════════════════════════╝

EOF
    exit 1
fi

# ── 约束2: 合并 datacloud 到其他分支 → 只允许 develop ──
if is_from_datacloud; then
    if [ "$CURRENT_BRANCH" = "develop" ]; then
        exit 0
    fi
    cat <<EOF >&2

╔══════════════════════════════════════════════════════════╗
║  ⛔  合并被拒绝  —  datacloud 出向保护                  ║
╠══════════════════════════════════════════════════════════╣
║                                                        ║
║  datacloud 分支只能被 develop 分支合并。                ║
║  当前在 "${CURRENT_BRANCH}" 分支上合并 datacloud。      ║
║                                                        ║
║  ✅ 正确的操作:                                         ║
║     git checkout develop                               ║
║     git merge datacloud                                ║
║                                                        ║
║  ↩️  撤销: git merge --abort                            ║
║                                                        ║
╚══════════════════════════════════════════════════════════╝

EOF
    exit 1
fi

# 其他合并不干预
exit 0
