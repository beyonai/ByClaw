      "type": "date",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "end",
      "paramName": "结束日期",
      "type": "date",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "stat_date",
      "paramName": "指标日期",
      "type": "date",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "category",
      "paramName": "分类数组",
      "type": "array",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "collection_id",
      "paramName": "合集ID",
      "type": "integer",
      "isRequired": false,
      "direction": "input",
      "term_type_code": "wy93ovzs9p_article_collection_collection_name",
