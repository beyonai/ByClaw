{
  "action_code": "get_article_context",
  "action_name": "单篇复盘上下文",
  "action_type": "QUERY",
  "action_desc": "按 article_id 返回文章元数据+指标+渠道+画像+账号基准；stat_date 可选，默认最新可用",
  "permission_roles": [
    "analyst",
    "ops",
    "admin"
  ],
  "params": [
    {
      "paramCode": "article_id",
      "paramName": "文章ID",
      "type": "integer",
      "isRequired": true,
      "direction": "input",
      "term_type_code": "wy93ovzs9p_article_title",
      "term_data_type": "LIST_TERM"
    },
    {
      "paramCode": "stat_date",
      "paramName": "指标日期",
      "type": "date",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "include_content",
      "paramName": "是否包含正文",
      "type": "boolean",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "benchmark_window_days",
      "paramName": "内部账号基准窗口",
      "type": "integer",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "success",
      "paramName": "是否成功",
      "type": "boolean",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "article",
      "paramName": "文章基础信息",
      "type": "object",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "metric",
      "paramName": "指标块",
      "type": "object",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "channel_summary",
      "paramName": "渠道汇总",
      "type": "object",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "profile",
      "paramName": "画像块",
      "type": "object",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "account_benchmarks",
      "paramName": "账号基准",
      "type": "object",
      "isRequired": false,
      "direction": "output"
    },
    {
