      "type": "string",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "code",
      "paramName": "错误码",
      "type": "string",
      "isRequired": false,
      "direction": "output"
    }
  ],
  "object_references": [
    "wy93ovzs9p_article_collection",
    "wy93ovzs9p_article_metric_daily",
    "wy93ovzs9p_article_channel_daily",
    "wy93ovzs9p_article_user_profile_daily"
  ]
