      "paramName": "命中总数",
      "type": "integer",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "page",
      "paramName": "当前页码",
      "type": "integer",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "page_size",
      "paramName": "每页条数",
      "type": "integer",
      "isRequired": false,
      "direction": "output"
    },
    {
      "paramCode": "error",
      "paramName": "错误描述",
      "type": "string",
      "isRequired": false,
      "direction": "output"
