{
  "action_code": "find_collections_by_keyword",
  "action_name": "按关键字模糊检索合集",
  "action_type": "QUERY",
  "action_desc": "按合集名称模糊检索（LIKE %kw%），按更新时间/创建时间倒序，支持分页；返回 collection_id、collection_name、collection_type 三列",
  "permission_roles": [
    "analyst",
    "ops",
    "admin"
  ],
  "params": [
    {
      "paramCode": "projectId",
      "paramName": "项目ID",
      "type": "string",
      "isRequired": true,
      "direction": "input"
    },
    {
      "paramCode": "account_code",
      "paramName": "公众号编码",
      "type": "string",
      "isRequired": true,
      "direction": "input"
    },
    {
      "paramCode": "keyword",
      "paramName": "合集名称关键字",
      "type": "string",
      "isRequired": true,
      "direction": "input"
    },
    {
      "paramCode": "page",
      "paramName": "页码（从 1 开始）",
      "type": "integer",
      "isRequired": false,
      "direction": "input"
    },
    {
      "paramCode": "page_size",
      "paramName": "每页条数（1-200）",
      "type": "integer",
      "isRequired": false,
      "direction": "input"
    },
    {
