{
  "action_code": "get_article_channel_metrics_by_period",
  "action_name": "按统计日期范围获取文章渠道阅读与分享",
  "action_type": "QUERY",
  "action_desc": "按项目、公众号和统计日期范围分页返回渠道阅读与分享每日增量（最多3个自然月、500篇显式文章）；可选限定单篇或一批文章ID和渠道。items按统计日明细分页，不按文章分页；第一页同时返回逐文章逐渠道汇总summary_by_article_channel、跨文章渠道汇总summary_by_channel、逐文章渠道覆盖和available_channels。仅覆盖完整时周期值为数字，缺日时周期值为null并单列observed小计；后续页不重复返回聚合。channel=全部是每篇文章总阅读/分享，不能与细分渠道重复相加。本对象不承载收藏、点赞、完读率等非渠道指标",
  "permission_roles": ["analyst", "ops", "admin"],
  "params": [
    {"paramCode": "projectId", "paramName": "项目ID", "type": "string", "isRequired": true, "direction": "input"},
    {"paramCode": "account_code", "paramName": "公众号编码", "type": "string", "isRequired": true, "direction": "input"},
    {"paramCode": "stat_date_from", "paramName": "统计日期下限（含，YYYY-MM-DD）", "type": "date", "isRequired": true, "direction": "input"},
    {"paramCode": "stat_date_to", "paramName": "统计日期上限（含，YYYY-MM-DD）", "type": "date", "isRequired": true, "direction": "input"},
    {"paramCode": "article_ids", "paramName": "文章ID列表（元素必须为整数）", "type": "array", "itemType": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "channels", "paramName": "渠道列表（元素必须为字符串），例如全部、推荐、搜一搜、聊天会话、朋友圈、公众号消息、公众号主页、其他", "type": "array", "itemType": "string", "isRequired": false, "direction": "input"},
    {"paramCode": "page", "paramName": "页码（从1开始）", "type": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "page_size", "paramName": "每页条数（1-200）", "type": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "success", "paramName": "是否成功", "type": "boolean", "isRequired": false, "direction": "output"},
    {"paramCode": "data_status", "paramName": "数据状态（available/no_data/no_matching_filter）", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "period", "paramName": "实际查询统计周期", "type": "object", "isRequired": false, "direction": "output"},
    {"paramCode": "metric_mode", "paramName": "指标模式（daily_increment）", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "items", "paramName": "渠道每日阅读与分享增量", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "available_channels", "paramName": "完整查询范围出现的渠道（仅第一页返回）", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "summary_by_channel", "paramName": "完整查询范围按渠道汇总（仅第一页返回）", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "summary_by_article_channel", "paramName": "完整查询范围逐文章逐渠道阅读分享汇总（仅第一页返回）", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "summary_scope", "paramName": "汇总范围（full_period/not_returned）", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "aggregate_returned", "paramName": "本页是否返回完整周期聚合", "type": "boolean", "isRequired": false, "direction": "output"},
    {"paramCode": "coverage_by_article", "paramName": "逐文章、目标渠道的每日覆盖和缺失日期", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "total_matched", "paramName": "符合条件的总条数", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "page", "paramName": "当前页码", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "page_size", "paramName": "每页条数", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "error", "paramName": "错误描述", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "code", "paramName": "错误码", "type": "string", "isRequired": false, "direction": "output"}
  ],
  "object_references": ["wy93ovzs9p_article"]
}
