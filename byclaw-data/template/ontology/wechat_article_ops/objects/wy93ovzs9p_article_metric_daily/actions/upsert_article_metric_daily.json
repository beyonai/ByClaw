      "type": "string",
      "isRequired": true,
      "direction": "input"
    },
    {
      "paramCode": "account_name",
      "paramName": "公众号名称",
      "type": "string",
      "isRequired": true,
      "direction": "input"
    },
    {
      "paramCode": "article_id",
      "paramName": "文章ID",
      "type": "integer",
      "isRequired": true,
      "direction": "input",
