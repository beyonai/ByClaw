{
  "action_code": "get_article_metrics_by_period",
  "action_name": "按统计日期范围查询文章阅读指标",
  "action_type": "QUERY",
  "action_desc": "按项目、公众号和统计日期范围查询文章全量累计快照（最多3个自然月、500篇文章）；可选限定文章ID。items按统计日分页，不按文章分页；第一页返回完整周期聚合，后续页不重复。阅读量和分享量汇总渠道 daily_increment 的 channel=全部并返回缺失日期，缺日时周期值为null并单列已观测日合计；其他累计计数仅在期初前一日和期末快照边界完整时计算请求周期差值，中间日期缺快照不影响计算，缺任一边界时差值返回null；比例和均值仅返回最近观测值",
  "permission_roles": ["analyst", "ops", "admin"],
  "params": [
    {"paramCode": "projectId", "paramName": "项目ID", "type": "string", "isRequired": true, "direction": "input"},
    {"paramCode": "account_code", "paramName": "公众号编码", "type": "string", "isRequired": true, "direction": "input"},
    {"paramCode": "stat_date_from", "paramName": "统计日期下限（含，YYYY-MM-DD）", "type": "date", "isRequired": true, "direction": "input"},
    {"paramCode": "stat_date_to", "paramName": "统计日期上限（含，YYYY-MM-DD）", "type": "date", "isRequired": true, "direction": "input"},
    {"paramCode": "article_ids", "paramName": "文章ID列表（元素必须为整数）", "type": "array", "itemType": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "page", "paramName": "页码（从1开始）", "type": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "page_size", "paramName": "每页条数（1-200）", "type": "integer", "isRequired": false, "direction": "input"},
    {"paramCode": "success", "paramName": "是否成功", "type": "boolean", "isRequired": false, "direction": "output"},
    {"paramCode": "period", "paramName": "实际查询统计周期", "type": "object", "isRequired": false, "direction": "output"},
    {"paramCode": "items", "paramName": "文章每日指标明细", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "changes_by_article", "paramName": "逐文章累计计数变化与期末比例均值", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "observed_read_share", "paramName": "渠道缺日时逐文章已观测日阅读分享合计（位于changes_by_article）", "type": "object", "isRequired": false, "direction": "output"},
    {"paramCode": "change_summary", "paramName": "累计计数变化汇总及缺失覆盖", "type": "object", "isRequired": false, "direction": "output"},
    {"paramCode": "change_scope", "paramName": "变化计算文章范围", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "aggregate_returned", "paramName": "本页是否返回完整周期聚合", "type": "boolean", "isRequired": false, "direction": "output"},
    {"paramCode": "non_additive_rule", "paramName": "比例和均值处理规则", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "snapshot_gap_rule", "paramName": "快照缺失处理规则", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "read_share_source", "paramName": "周期阅读和分享来源", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "total_matched", "paramName": "符合条件的总条数", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "page", "paramName": "当前页码", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "page_size", "paramName": "每页条数", "type": "integer", "isRequired": false, "direction": "output"},
    {"paramCode": "missing_article_ids", "paramName": "未找到的文章ID", "type": "array", "isRequired": false, "direction": "output"},
    {"paramCode": "error", "paramName": "错误描述", "type": "string", "isRequired": false, "direction": "output"},
    {"paramCode": "code", "paramName": "错误码", "type": "string", "isRequired": false, "direction": "output"}
  ],
  "object_references": ["wy93ovzs9p_article", "wy93ovzs9p_article_channel_daily"]
}
