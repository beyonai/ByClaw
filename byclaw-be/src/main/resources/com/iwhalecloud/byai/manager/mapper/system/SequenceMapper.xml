<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.iwhalecloud.byai.manager.mapper.system.SequenceMapper">

	<select id="nextValForUdal" resultType="java.lang.Long" useCache="false" flushCache="true">
		select ${sequenceName}.nextval
	</select>

	<select id="nextValForOracle" resultType="java.lang.Long" useCache="false" flushCache="true">
		select ${sequenceName}.nextval  from dual
	</select>

    <select id="nextValForPostgreSql" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT nextval(#{sequenceName})
    </select>

	<insert id="nextValForMySqlIncrement" useGeneratedKeys="true" keyProperty="id">
		  insert into id(id) values(null)
	</insert>

  <delete id="clearMySqlIncrement" parameterType="long">
	  delete from id where id <![CDATA[ < ]]> #{id}
  </delete>

    <select id="nextValuesForPostgreSql" resultType="java.lang.Long" useCache="false" flushCache="true">
        <!-- openGauss 6 can fail when nextval is evaluated over a FROM generate_series scan.
             Each UNION ALL arm allocates independently; the caller bounds a batch to 500. -->
        <bind name="rows" value="@java.util.Collections@nCopies(count, 0)"/>
        <foreach collection="rows" item="ignored" separator=" UNION ALL ">
            SELECT nextval(#{sequenceName})
        </foreach>
    </select>
    <select id="nextValuesForOracle" resultType="java.lang.Long" useCache="false" flushCache="true">
        SELECT ${sequenceName}.nextval FROM dual CONNECT BY level &lt;= #{count}
    </select>
</mapper>
