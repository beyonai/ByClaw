# 运行阶段（JAR 由 CI 预先构建）— 含 DWS CLI 支持
FROM eclipse-temurin:21-jre-alpine

# 创建应用目录
WORKDIR /app

# 安装 dws 依赖：gcompat（glibc兼容层）
# token 使用 dws 的 file-DEK 后端（DWS_DISABLE_KEYCHAIN=1）加密落盘，
# 不再依赖 gnome-keyring/dbus，token 随 /root/.dws 持久卷跨重启保留。
RUN apk add --no-cache \
    curl \
    bash \
    gcompat \
    && rm -rf /var/cache/apk/*

# 安装 DWS CLI（使用预下载的二进制，避免构建时网络下载）
COPY docker/dws/dws-linux-amd64.tar.gz /tmp/dws.tar.gz
RUN mkdir -p /root/.local/bin \
    && tar -xzf /tmp/dws.tar.gz -C /root/.local/bin dws \
    && chmod +x /root/.local/bin/dws \
    && rm -f /tmp/dws.tar.gz \
    && /root/.local/bin/dws --version
# DWS_DISABLE_KEYCHAIN=1：改用 file-DEK 后端，token 加密存 /root/.dws，挂持久卷即可跨重启保留
ENV DWS_NO_SKILLS=1 \
    DWS_DISABLE_KEYCHAIN=1 \
    PATH="/root/.local/bin:${PATH}"

# 清理 dws 不需要的 skills 目录
RUN rm -rf /root/.agents/skills

# 构建信息参数（由 CI/Jenkins/本地脚本通过 --build-arg 传入）
ARG BUILD_VERSION=unknown
ARG BUILD_BRANCH=unknown
ARG BUILD_COMMIT=unknown
ARG BUILD_COMMIT_FULL=unknown
ARG BUILD_TIME=unknown
ARG BUILD_MODULE=byclaw-be
ARG BUILD_COMMIT_MSG=unknown

RUN printf '{"version":"%s","branch":"%s","commit":"%s","commitFull":"%s","buildTime":"%s","module":"%s","commitMsg":"%s"}\n' \
    "$BUILD_VERSION" "$BUILD_BRANCH" "$BUILD_COMMIT" "$BUILD_COMMIT_FULL" "$BUILD_TIME" "$BUILD_MODULE" "$BUILD_COMMIT_MSG" \
    > /app/build-info.json

# 复制构建好的 JAR 文件
COPY target/*.jar app.jar

# dws token 走 file-DEK 后端存 /root/.dws，需将该目录挂持久卷才能跨重启保留登录态

# 暴露端口
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# 启动 Java 应用（token 走 file-DEK 后端，无需 keyring 初始化）
CMD ["java", "-jar", "app.jar"]
