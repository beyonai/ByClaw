#!/usr/bin/env sh

# ============================================================
# Pre-commit hook — smart module-level checks
# Only runs checks for modules that have staged changes.
# ============================================================

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Detect which modules have staged changes
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

HAS_FE=false
HAS_BE=false
HAS_EXE=false
HAS_DATA=false
HAS_KGW=false
HAS_SUPPER=false

for file in $STAGED_FILES; do
  case "$file" in
    byclaw-fe/*) HAS_FE=true ;;
    byclaw-be/*) HAS_BE=true ;;
    byclaw-exe/*) HAS_EXE=true ;;
    byclaw-data/*) HAS_DATA=true ;;
    byclaw-kgw/*) HAS_KGW=true ;;
    byclaw-supper/*) HAS_SUPPER=true ;;
  esac
done

# Git 会向 hook 导出当前仓库专属的 GIT_DIR、GIT_INDEX_FILE 等变量。
# 后续测试若在临时目录创建 Git 仓库，继承这些变量会误操作当前 worktree。
# staged 文件识别完成后清除这些变量，让子进程按各自工作目录发现仓库。
unset $(git rev-parse --local-env-vars)

EXIT_CODE=0

# ────────────────────────────────────────────────────────────
# Version pinning check: reject unpinned deps in FE & Python
# ────────────────────────────────────────────────────────────
check_version_pinning() {
  local has_unpinned=false

  for pkg_file in $(echo "$STAGED_FILES" | grep -E '(^|/)package\.json$'); do
    if [ -f "$REPO_ROOT/$pkg_file" ]; then
      unpinned=$(grep -nE '"[^"]+"\s*:\s*"[\^~]' "$REPO_ROOT/$pkg_file" | grep -v '"name"\|"version"\|"description"' || true)
      if [ -n "$unpinned" ]; then
        echo "❌ [pre-commit] Unpinned dependencies in $pkg_file:"
        echo "$unpinned" | head -10
        echo "   Remove ^ or ~ prefix to pin exact versions"
        has_unpinned=true
      fi
    fi
  done

  for toml_file in $(echo "$STAGED_FILES" | grep -E '(^|/)pyproject\.toml$'); do
    if [ -f "$REPO_ROOT/$toml_file" ]; then
      unpinned=$(grep -nE '^\s*"[^"]*(>=|<=|~=|!=|>[0-9]|<[0-9])' "$REPO_ROOT/$toml_file" | grep -v 'requires-python' || true)
      if [ -n "$unpinned" ]; then
        echo "❌ [pre-commit] Unpinned dependencies in $toml_file:"
        echo "$unpinned" | head -10
        echo "   Use exact versions (e.g. \"package==1.2.3\")"
        has_unpinned=true
      fi
    fi
  done

  if [ "$has_unpinned" = true ]; then
    EXIT_CODE=1
  fi
}

check_version_pinning

# ────────────────────────────────────────────────────────────
# Frontend checks: lint-staged (on staged files) + tests
# ────────────────────────────────────────────────────────────
if [ "$HAS_FE" = true ]; then
  echo "🔍 [pre-commit] Running frontend checks..."

  # lint-staged: prettier + eslint + stylelint on staged files
  cd "$REPO_ROOT/byclaw-fe"
  npx lint-staged --concurrent false
  if [ $? -ne 0 ]; then
    echo "❌ [pre-commit] Frontend lint-staged failed"
    EXIT_CODE=1
  fi

  # 全量前端测试在低内存开发机上限制并发，避免浏览器预览类用例因 worker 争抢而超时。
  pnpm run test --passWithNoTests --maxWorkers=2 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ [pre-commit] Frontend tests failed"
    EXIT_CODE=1
  else
    echo "✅ [pre-commit] Frontend checks passed"
  fi

  cd "$REPO_ROOT"
fi

# ────────────────────────────────────────────────────────────
# Backend checks: mvn test
# ────────────────────────────────────────────────────────────
if [ "$HAS_BE" = true ]; then
  echo "🔍 [pre-commit] Running backend checks..."

  mvn -B -f "$REPO_ROOT/byclaw-be/pom.xml" test
  if [ $? -ne 0 ]; then
    echo "❌ [pre-commit] Backend tests failed"
    EXIT_CODE=1
  else
    echo "✅ [pre-commit] Backend checks passed"
  fi
fi

# ────────────────────────────────────────────────────────────
# Python (byclaw-exe) checks: ruff + pytest
# ────────────────────────────────────────────────────────────
if [ "$HAS_EXE" = true ]; then
  echo "🔍 [pre-commit] Running byclaw-exe checks..."

  cd "$REPO_ROOT/byclaw-exe"
  if command -v ruff >/dev/null 2>&1; then
    ruff check .
    if [ $? -ne 0 ]; then
      echo "❌ [pre-commit] byclaw-exe ruff check failed"
      EXIT_CODE=1
    fi
  fi

  if command -v pytest >/dev/null 2>&1; then
    pytest
    if [ $? -ne 0 ]; then
      echo "❌ [pre-commit] byclaw-exe pytest failed"
      EXIT_CODE=1
    fi
  fi

  if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ [pre-commit] byclaw-exe checks passed"
  fi
  cd "$REPO_ROOT"
fi

# ────────────────────────────────────────────────────────────
# Python (byclaw-data) checks: ruff
# ────────────────────────────────────────────────────────────
if [ "$HAS_DATA" = true ]; then
  echo "🔍 [pre-commit] Running byclaw-data checks..."

  cd "$REPO_ROOT/byclaw-data"
  if command -v ruff >/dev/null 2>&1; then
    ruff check .
    if [ $? -ne 0 ]; then
      echo "❌ [pre-commit] byclaw-data ruff check failed"
      EXIT_CODE=1
    else
      echo "✅ [pre-commit] byclaw-data checks passed"
    fi
  fi
  cd "$REPO_ROOT"
fi

# ────────────────────────────────────────────────────────────
# Python (byclaw-kgw) checks: pre-commit
# ────────────────────────────────────────────────────────────
if [ "$HAS_KGW" = true ]; then
  echo "🔍 [pre-commit] Running byclaw-kgw checks..."

  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --config byclaw-kgw/.pre-commit-config.yaml
    if [ $? -ne 0 ]; then
      echo "❌ [pre-commit] byclaw-kgw checks failed"
      EXIT_CODE=1
    else
      echo "✅ [pre-commit] byclaw-kgw checks passed"
    fi
  else
    echo "⚠️  [pre-commit] pre-commit not found, skipping byclaw-kgw checks"
  fi
fi

# ────────────────────────────────────────────────────────────
# Python (byclaw-supper) checks: pre-commit
# ────────────────────────────────────────────────────────────
if [ "$HAS_SUPPER" = true ]; then
  echo "🔍 [pre-commit] Running byclaw-supper checks..."

  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --config byclaw-supper/.pre-commit-config.yaml
    if [ $? -ne 0 ]; then
      echo "❌ [pre-commit] byclaw-supper checks failed"
      EXIT_CODE=1
    else
      echo "✅ [pre-commit] byclaw-supper checks passed"
    fi
  else
    echo "⚠️  [pre-commit] pre-commit not found, skipping byclaw-supper checks"
  fi
fi

# ────────────────────────────────────────────────────────────
# Summary
# ────────────────────────────────────────────────────────────
if [ "$HAS_FE" = false ] && [ "$HAS_BE" = false ] && [ "$HAS_EXE" = false ] && [ "$HAS_DATA" = false ] && [ "$HAS_KGW" = false ] && [ "$HAS_SUPPER" = false ]; then
  echo "⏭️  [pre-commit] No module changes detected, skipping checks"
fi

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🚫 Pre-commit checks failed. Please fix the issues above before committing."
  echo "   To bypass (emergency only): git commit --no-verify"
fi

exit $EXIT_CODE
