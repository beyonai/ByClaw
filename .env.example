# Domain name
BE_DOMAINNAME=ByaiService
QA_DOMAINNAME=byclaw-qa-manager
DATACLOUD_DOMAINNAME=byclaw-datacloud

# Server
HOST=127.0.0.1
NGINX_PORT=8080
NGINX_HTTPS_PORT=8443
BE_SERVER_PORT=8086
BE_WS_PORT=8082
BYCLAW_QA_PORT=8000
DATACLOUD_PORT=8088

# Database
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_SCHEMA=byai
DB_USER=gaussdb
DB_PASS=Admin@123

# Redis MODE(standalone or cluster,default standalone)
#REDIS_MODE=standalone

# Redis Cluster(example:127.0.0.1:6371,127.0.0.1:6372,127.0.0.1:6373,127.0.0.1:6374,127.0.0.1:6375,127.0.0.1:6376)
#REDIS_CLUSTER_HOST=
#REDIS_KEY_SCHEMA_VERSION=v2

# Redis Standalone (example:127.0.0.1)
REDIS_HOST=
REDIS_PORT=6379
REDIS_MODE=standalone
# REDIS_CLUSTER_HOST=redis-1:6379,redis-2:6379
REDIS_DATABASE=0

# Redis Auth
REDIS_USERNAME=default
REDIS_PASSWORD=


# ============================================================
# 存储部署方案
# ============================================================
# deploy.sh 只区分 init / update / stop 三个阶段，具体使用 MinIO 还是 NFS 全部由 .env 驱动。
# 首次部署：sh deploy.sh init
# 增量更新：sh deploy.sh update
#
# BYCLAW_DEPLOY_STORAGE 可选值：
#   minio      兼容旧版方案：上传/下载接口使用 MinIO，OpenClaw /by 通过 rclone 挂载 MinIO bucket
#   nfs        推荐 Docker 新部署：上传/下载接口和 OpenClaw /by 都使用 NFS 文件型存储
#   nfs-hybrid 过渡方案：OpenClaw /by 使用 NFS，上传/下载接口继续使用 MinIO
BYCLAW_DEPLOY_STORAGE=nfs

# nfs 模式默认不启动 MinIO；如果仍需要保留 MinIO 做归档/备份/临时兼容，改为 true。
BYCLAW_DEPLOY_START_MINIO=false

# 是否在 sh deploy.sh init 阶段通过 SSH 自动初始化 NFS Server 和各 Docker 宿主机挂载点。
# 增量更新 sh deploy.sh update 不会重复初始化 NFS。
BYCLAW_DEPLOY_INIT_NFS=false

# ============================================================
# NFS SSH 初始化参数，仅 BYCLAW_DEPLOY_INIT_NFS=true 且执行 sh deploy.sh init 时生效
# ============================================================
# NFS Server 地址，也就是导出 /exports/byclaw 的 A 服务器。
BYCLAW_NFS_SERVER_HOST=
BYCLAW_NFS_SERVER_PORT=22
BYCLAW_NFS_SERVER_USER=root
BYCLAW_NFS_SERVER_PASSWORD=

# NFS Server 上导出的根目录。
BYCLAW_NFS_EXPORT_PATH=/exports/byclaw

# NFS 允许访问的客户端范围。* 表示全网段可挂载，适合快速验证；生产建议改成内网网段或固定 IP。
BYCLAW_NFS_EXPORT_CLIENTS=*

# 需要挂载 NFS 的 Docker/openSandbox 宿主机列表，多个用英文逗号分隔。
BYCLAW_NFS_CLIENT_HOSTS=
BYCLAW_NFS_CLIENT_PORT=22
BYCLAW_NFS_CLIENT_USER=root
BYCLAW_NFS_CLIENT_PASSWORD=

# 客户端挂载参数：
# rw      读写挂载
# hard    服务端短暂不可用时阻塞等待，避免静默丢数据
# noatime 减少访问时间写入
# nconnect=4 使用多个 TCP 连接提高吞吐，老内核不支持时可删除
# _netdev 标记为网络文件系统，开机时等待网络后挂载
BYCLAW_NFS_MOUNT_OPTIONS=rw,hard,noatime,nconnect=4,_netdev

# ============================================================
# 文件接口存储配置
# ============================================================
# FILE_STORAGE_TYPE=minio：上传/下载/list/delete 等接口走 MinIO。
# FILE_STORAGE_TYPE=file ：上传/下载/list/delete 等接口走服务器文件系统。
# 通常不需要手工改这个值，deploy/storage-profile.sh 会按 BYCLAW_DEPLOY_STORAGE 自动设置。
FILE_STORAGE_TYPE=file

# FILE_STORAGE_TYPE=file 时 BE 使用的文件根目录。NFS 模式下应与 BYCLAW_SANDBOX_FILE_VOLUME_ROOT 一致。
FILE_STORAGE_LOCAL_PATH=/mnt/byclaw-file

# MinIO
FILE_STORAGE_MINIO_HOST=127.0.0.1
FILE_STORAGE_MINIO_API_PORT=9009
FILE_STORAGE_MINIO_UI_PORT=9019
FILE_STORAGE_MINIO_ACCESS_KEY=your_minio_access_key
FILE_STORAGE_MINIO_SECRET_KEY=your_minio_secret_key
FILE_STORAGE_MINIO_SECURE=false
FILE_STORAGE_MINIO_BUCKET_NAME=byclaw

# 兼容旧版：是否通过 rclone 把 MinIO bucket 挂成运行态目录。
# BYCLAW_SANDBOX_VOLUME_BACKEND=file 使用 NFS/SMB/CephFS 时必须保持 false。
FILE_STORAGE_MINIO_MOUNT_ENABLED=false
FILE_STORAGE_MINIO_MOUNT_PATH=your_legacy_mount_path

# 兼容旧版 rclone 挂载目标，仅 minio 方案需要。
FILE_STORAGE_MINIO_MOUNT_TARGET_0_ENABLED=true
FILE_STORAGE_MINIO_MOUNT_TARGET_0_HOST=your_mount_host
FILE_STORAGE_MINIO_MOUNT_TARGET_0_PORT=22
FILE_STORAGE_MINIO_MOUNT_TARGET_0_USER=your_ftp_username
FILE_STORAGE_MINIO_MOUNT_TARGET_0_PASSWORD=your_ftp_password

# Resource validator flag
RESOURCE_JSON_CONNECTIVITY_VALIDATION_ENABLED=true
RESOURCE_JSON_CONNECTIVITY_VALIDATION_FAIL_FAST=true



# ============================================================
# OpenSandbox 运行态卷配置
# ============================================================
BYCLAW_SANDBOX_ENABLE=true
BYCLAW_SANDBOX_BASE_URL=http://127.0.0.1:8090
BYCLAW_SANDBOX_API_KEY=dev
BYCLAW_SANDBOX_ENDPOINT_SCHEME=http
BYCLAW_SANDBOX_PERMANENT_KEEP=true
BYCLAW_SANDBOX_STORAGE_MODE=sftp
BYCLAW_SANDBOX_HEARTBEAT_TIMEOUT=PT5M

# minio-mount：兼容旧版，由 rclone/FUSE 把 MinIO bucket 挂载给 OpenClaw /by。
# file       ：推荐新方案，由宿主机上的文件型存储目录 bind 给 OpenClaw /by。
# 通常不需要手工改这个值，deploy/storage-profile.sh 会按 BYCLAW_DEPLOY_STORAGE 自动设置。
BYCLAW_SANDBOX_VOLUME_BACKEND=file

# OpenClaw /by 对应的宿主机统一根目录。NFS 模式下所有 Docker/openSandbox 宿主机都要挂载到同一路径。
BYCLAW_SANDBOX_FILE_VOLUME_ROOT=/mnt/byclaw-file

# Recorder 生产发布默认关闭。启用前，用户专属 sandbox 必须：
# 1. 以读写方式挂载 <BYCLAW_SANDBOX_FILE_VOLUME_ROOT>/byclaw-<exact userCode>/by 到 /by；
# 2. 镜像设置 BYCLI_CONFIG_DIR=/by/.bycli、BYCLI_DAEMON_HOST=0.0.0.0，并保证运行用户可写配置目录；
# 3. 使用 Node.js >= 20.6 启动 byCLI daemon，并将 HTTP 19825 在 sandbox spec 中注册为 instance=bycli。
# Dashboard/BE 不设置全局 BYCLI_CONFIG_DIR，也不使用独立的 recorder host volume root。
RECORDER_SAVE_ADAPTER_PRODUCTION_ENABLED=false
RECORDER_SAVE_ADAPTER_INSTANCE=bycli

# 文件型存储类型，仅用于配置诊断和日志：nfs / bind / smb / cephfs。
BYCLAW_SANDBOX_FILE_VOLUME_TYPE=nfs

# 快照提供方标记。NFS/NAS 场景使用 nas；纯本地 bind 可使用 none。
BYCLAW_SANDBOX_FILE_VOLUME_SNAPSHOT_PROVIDER=nas
BYCLAW_SANDBOX_FILE_BROWSER_ENABLED=false

AGENT_POOL_BASE_URL=http://127.0.0.1:8087
AGENT_POOL_TOKEN=< your agent pool token >

# Channel Stream Bot (DingTalk + WeCom share one switch)
CHANNEL_STREAM_ENABLE=false
CHANNEL_STREAM_SHOW_REASONING=false

# Lark connector credentials (leave empty; never commit real secrets)
CONNECTOR_LARK_APP_ID=
CONNECTOR_LARK_APP_SECRET=

# init user's resources to redis after the server start
INIT_USER_AUTH_RESOURCES_REDIS_ENABLED=true

# init digital employees and related resource JSON snapshots to redis after server start (async)
INIT_DIG_EMPLOYEE_REDIS_ENABLED=false

# =========================================================
# byclaw-qa shared runtime variables
# These variables are defined at the repo level with the
# fixed `BYCLAW_QA_` prefix and mapped by `byclaw-qa/start.sh`
# to the variable names expected by the Q&A application.
# =========================================================
BYCLAW_QA_AGENT_DATA_PATH=agent_data

BYCLAW_QA_KB_FETCH_CACHE_TTL_SECONDS=86400
BYCLAW_QA_KB_FETCH_CACHE_CLEANUP_INTERVAL_SECONDS=600

BYCLAW_QA_KB_MINIO_BUCKET=knowledge-base
BYCLAW_QA_KB_MINIO_MARKDOWN_BUCKET=knowledge-base-markdown

BYCLAW_QA_BYAI_WORKER_ID=instant-search-worker

# ============================================================
# whale-datacloud 推荐 .env 清单
# 说明：
# 1. 只保留当前主运行时代码仍会读取的环境变量
# 2. 每个变量前一行是说明
# 3. 可选项保留为空或注释掉
# ============================================================


# ============================================================
# 一、数据库配置
# ============================================================


# 数据库连接超时（秒），主要用于 knowledge 导入
DATACLOUD_DB_CONNECT_TIMEOUT=30

# 数据库锁等待超时（毫秒），主要用于 knowledge 导入
DATACLOUD_DB_LOCK_TIMEOUT_MS=30000


# ============================================================
# 三、Agent / Analysis 配置
# ============================================================

# Agent 语言地区
DATACLOUD_AGENT_LOCALE=zh_CN

# 是否禁用 ask_user 工具：1=true，0=false
DATACLOUD_DISABLE_ASK_USER_TOOL=1

# ReAct 最大轮数
DATACLOUD_REACT_MAX_ROUNDS=10

# 最终输出格式，常见值：markdown
DATACLOUD_OUTPUT_FORMAT=markdown

# 命令插件目录，可多个，按约定分隔
DATACLOUD_COMMAND_PLUGIN_DIRS=

# 工具 Hook 插件目录，可多个，按约定分隔
DATACLOUD_TOOL_HOOK_PLUGIN_DIRS=

# 是否启用预构建 ReAct 路径
DATACLOUD_USE_PREBUILT_REACT=false

# 历史对话轮数
DATACLOUD_HISTORY_MESSAGE_LIMIT=6


# ============================================================
# 四、Gateway / Worker 配置
# ============================================================


# Worker 节点标识
DATACLOUD_GATEWAY_WORKER_ID=BYCLAW_DATA

DATACLOUD_GATEWAY_CONSUMER_GROUP=datacloud


# ============================================================
# 五、Data Service 配置
# ============================================================

# 查询结果超过多少行时落 CSV，同时预览只返回前 N 行
DATACLOUD_QUERY_RESULT_CSV_THRESHOLD=5


# 查询计划生成最大重试次数
DATACLOUD_MAX_PLAN_RETRIES=2


# static：不自动重载，也不启动 watcher、 lazy：请求时检查变化并重载，但不启动 watcher、watch：启动 watcher，且保留自动重载能力
DATACLOUD_LOADER_MODE=watch

# watch时才生效
DATACLOUD_LOADER_RELOAD_DEBOUNCE_MS=500

# CORS 白名单，多个用逗号分隔
DATACLOUD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ============================================================
# 六、日志配置
# ============================================================

# 日志目录
DATACLOUD_LOG_DIR=./logs

# 日志级别：DEBUG / INFO / WARNING / ERROR
DATACLOUD_LOG_LEVEL=INFO

# app.log 保留天数
DATACLOUD_LOG_APP_KEEP=30

# error.log 保留天数
DATACLOUD_LOG_ERROR_KEEP=90

# middleware
IMAGE_REDIS=ghcr.io/beyonai/byclaw/byclaw-redis:main
IMAGE_MINIO=ghcr.io/beyonai/byclaw/byclaw-minio:main
IMAGE_OPENGAUSS=ghcr.io/beyonai/byclaw/byclaw-opengauss:main
IMAGE_OPENCLAW=ghcr.io/beyonai/byclaw/byclaw-openclaw:main
IMAGE_SANDBOX_SERVER=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/server:v0.1.9
IMAGE_SANDBOX_EXECD=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/execd:v1.0.9
IMAGE_SANDBOX_EGRESS=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/egress:v1.0.3

# standalone
IMAGE_FE=ghcr.io/beyonai/byclaw/byclaw-fe:main
IMAGE_BE=ghcr.io/beyonai/byclaw/byclaw-be:main
IMAGE_SUPER=ghcr.io/beyonai/byclaw/byclaw-super:main
IMAGE_QA=ghcr.io/beyonai/byclaw/byclaw-qa:main
IMAGE_DATA=ghcr.io/beyonai/byclaw/byclaw-data:main
IMAGE_DEMO=ghcr.io/beyonai/byclaw-middleware/byclaw-demo:main

# ============================================================
# ByClaw Super
# ============================================================
BYCLAW_SUPER_PORT=3000
BYCLAW_SUPER_REPLICAS=1
BYCLAW_SUPER_DB_SSL=false
BYCLAW_SUPER_DB_EVENT_LISTEN_ENABLED=false
BYCLAW_SUPER_BE_BASE_URL=http://be:8086
BYCLAW_WORKER_ENABLED=true
BYCLAW_WORKER_AGENT_TYPE=BY_SUPER
BYCLAW_WORKER_MAX_CONCURRENCY=10

# Pi 模型配置。智谱/OpenAI 兼容接口使用 OPENAI_API_KEY；
# 火山方舟改用 PI_PROVIDER=volcengine-ark 并填写 ARK_BASE_URL/ARK_API_KEY。
PI_PROVIDER=zhipu
PI_MODEL=glm-5.2
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=

# RSA
BYCLAW_RSA_
BYCLAW_RSA_PRIVATE_
BYCLAW_RSA_PUBLIC_KEY=65537
