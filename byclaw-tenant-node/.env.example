# Fixed tenant identity; injected by the provisioning service.
ENTERPRISE_ID=12345
TENANT_ID=12345
TENANT_GENERATION=7
DB_SANDBOX_RECORD_ID=67890
INSTANCE_ID=tenant-node-12345
HOST=0.0.0.0
PORT=3100
ADVERTISE_HOST=tenant-node.example.test
NODE_STATE_DIR=/var/lib/byclaw-tenant

# Use separate Redis options. Credentials come from the Secret manager.
REDIS_HOST=redis.example.test
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TLS=true
REDIS_USERNAME=
REDIS_PASSWORD=

# BE_INTERNAL_URL includes the /byaiService context path.
BE_INTERNAL_URL=https://be.example.test/byaiService
BE_CLIENT_IDENTITY=byclaw-be
KMS_DECRYPT_URL=https://kms.example.test/tenant-credentials/decrypt
TLS_CERT_FILE=/run/secrets/node.crt
TLS_KEY_FILE=/run/secrets/node.key
TLS_CA_FILE=/run/secrets/tenant-ca.crt
