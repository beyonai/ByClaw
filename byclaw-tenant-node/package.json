    "fastify": "5.10.0",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "pgsql-ast-parser": "12.0.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.28",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/yauzl": "2.10.3",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
