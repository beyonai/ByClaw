{
  "overwrite": true,
  "folderUid": "",
  "message": "ByClaw K3s node overview dashboard",
  "dashboard": {
    "uid": "byclaw-k3s-nodes",
    "title": "K3s 集群节点概览",
    "tags": ["byclaw", "k3s", "nodes"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {"from": "now-1h", "to": "now"},
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 2,
          "refresh": 1
        },
        {
          "name": "node",
          "type": "query",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "query": {"query": "label_values(kube_node_info, node)", "refId": "StandardVariableQuery"},
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "refresh": 2,
          "sort": 1,
          "current": {}
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "节点总数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "count(kube_node_info)", "instant": true}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}
      },
      {
        "id": 2,
        "title": "Ready 节点",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "instant": true}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
      },
      {
        "id": 3,
        "title": "集群 Pod 总数",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "count(kube_pod_info)", "instant": true}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}}}
      },
      {
        "id": 4,
        "title": "NotReady 节点",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "count(kube_node_info) - sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "instant": true}],
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
      },
      {
        "id": 5,
        "title": "各节点 Pod 数量",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "count by (node) (kube_pod_info{node=~\"$node\"})", "legendFormat": "{{node}}", "instant": true}],
        "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true},
        "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
      },
      {
        "id": 6,
        "title": "各节点 CPU 使用率 %",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "100 - (avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\",node=~\"$node\"}[5m])) * 100)", "legendFormat": "{{node}}", "instant": true}],
        "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true},
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}
      },
      {
        "id": 7,
        "title": "节点 CPU 使用率趋势",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "100 - (avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\",node=~\"$node\"}[5m])) * 100)", "legendFormat": "{{node}}"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 8,
        "title": "节点内存使用率趋势",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node=~\"$node\"})) * 100", "legendFormat": "{{node}}"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 9,
        "title": "节点工作负载 CPU (cores)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "sum by (instance) (rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\",instance=~\"$node\"}[5m]))", "legendFormat": "{{instance}}"}],
        "fieldConfig": {"defaults": {"unit": "cores", "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 10,
        "title": "节点工作负载内存",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "sum by (instance) (container_memory_working_set_bytes{container!=\"\",pod!=\"\",instance=~\"$node\"})", "legendFormat": "{{instance}}"}],
        "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}}
      },
      {
        "id": 11,
        "title": "节点详情",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 28},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [
          {"refId": "pods", "expr": "count by (node) (kube_pod_info{node=~\"$node\"})", "format": "table", "instant": true},
          {"refId": "cpu_pct", "expr": "100 - (avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\",node=~\"$node\"}[5m])) * 100)", "format": "table", "instant": true},
          {"refId": "mem_pct", "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node=~\"$node\"})) * 100", "format": "table", "instant": true},
          {"refId": "mem_total", "expr": "node_memory_MemTotal_bytes{job=\"node-exporter\",node=~\"$node\"}", "format": "table", "instant": true},
          {"refId": "cpu_alloc", "expr": "kube_node_status_allocatable{resource=\"cpu\",node=~\"$node\"}", "format": "table", "instant": true},
          {"refId": "mem_alloc", "expr": "kube_node_status_allocatable{resource=\"memory\",node=~\"$node\"}", "format": "table", "instant": true},
          {"refId": "ready", "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\",node=~\"$node\"}", "format": "table", "instant": true}
        ],
        "transformations": [
          {"id": "seriesToColumns", "options": {"byField": "node"}},
          {"id": "organize", "options": {
            "excludeByName": {"Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Time 6": true, "__name__": true, "condition": true, "instance": true, "job": true, "resource": true, "status": true, "unit": true, "Value #ready": true},
            "renameByName": {
              "node": "节点",
              "Value #pods": "Pod 数",
              "Value #cpu_pct": "CPU 使用率 %",
              "Value #mem_pct": "内存使用率 %",
              "Value #mem_total": "内存总量",
              "Value #cpu_alloc": "可分配 CPU",
              "Value #mem_alloc": "可分配内存"
            }
          }}
        ],
        "fieldConfig": {
          "defaults": {"custom": {"align": "auto"}},
          "overrides": [
            {"matcher": {"id": "byName", "options": "CPU 使用率 %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "decimals", "value": 1}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}]},
            {"matcher": {"id": "byName", "options": "内存使用率 %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "decimals", "value": 1}]},
            {"matcher": {"id": "byName", "options": "内存总量"}, "properties": [{"id": "unit", "value": "bytes"}]},
            {"matcher": {"id": "byName", "options": "可分配内存"}, "properties": [{"id": "unit", "value": "bytes"}]}
          ]
        },
        "options": {"showHeader": true, "sortBy": [{"displayName": "Pod 数", "desc": true}]}
      },
      {
        "id": 12,
        "title": "节点磁盘使用率 %",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "targets": [{"refId": "A", "expr": "(1 - (node_filesystem_avail_bytes{job=\"node-exporter\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|aufs\"} / node_filesystem_size_bytes{job=\"node-exporter\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|aufs\"})) * 100", "legendFormat": "{{node}} {{mountpoint}}"}],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
      }
    ]
  }
}
