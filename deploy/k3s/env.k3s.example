# ByClaw K3s + Longhorn 分布式部署环境变量
# 复制为 deploy/k3s/env.k3s，或放到 envs/<name>/env.k3s 供 scripts/deploy-k3s.sh 同步。

# ---------- 集群节点 ----------
# K3S_API_HOST：仅用于 scripts/deploy-k3s.sh 的 SSH 远程入口，可为公网 IP。
# k3s 集群通信（join/tls-san/node-ip/advertise）默认只用内网 IP（K3S_CLUSTER_INTERNAL_ONLY=true）。
K3S_API_HOST=k3s-api.example.com
K3S_CLUSTER_INTERNAL_ONLY=true
# 内网模式下由第一台 server 的内网 IP 自动推导，无需手填公网地址。
K3S_JOIN_URL=https://10.0.0.11:6443
# 仅填写内网 IP 或内网 DNS；公网 IP 会被忽略。
K3S_TLS_SANS=10.0.0.11
K3S_TOKEN=
K3S_INSTALL_CHANNEL=stable
# K3s 内置 ServiceLB，负责将 LoadBalancer Service 暴露到节点 hostPort。
# 如需保留完全内网集群，可显式设置为 false。
K3S_ENABLE_SERVICELB=true
# 国内服务器：加速 k3s 二进制下载，并自动配置 containerd 镜像加速（registries.yaml）
K3S_USE_CN_MIRROR=false
# 高级：也可手动指定安装脚本与镜像标识（K3S_USE_CN_MIRROR=false 时生效）
# K3S_INSTALL_SCRIPT_URL=https://rancher-mirror.rancher.cn/k3s/k3s-install.sh
# K3S_INSTALL_MIRROR=cn
# 高级：手动覆盖容器镜像加速（K3S_USE_CN_MIRROR=true 时有默认值）
# K3S_REGISTRY_MIRROR_DOCKER=https://docker.m.daocloud.io
# K3S_REGISTRY_MIRROR_K8S=https://registry.aliyuncs.com/google_containers
# K3S_REGISTRY_MIRROR_QUAY=https://quay.m.daocloud.io
# K3S_DISABLE_DEFAULT_REGISTRY_ENDPOINT=true
# 私有 Harbor / 自建镜像仓库（写入各节点 /etc/rancher/k3s/registries.yaml，支持多个，逗号分隔）
# 格式：host[:port]|username|password[|http|insecure]
#   - scheme 默认 https；http 仓库建议显式写 |http|true
#   - password 勿含逗号或竖线 |
#   - 整行必须用单引号或双引号包住（| 在 shell 里是管道符）
# 示例（请把 change-me 换成真实密码，勿提交到 git）：
# K3S_PRIVATE_REGISTRIES='192.168.0.158:8080|admin|change-me|http|true,harbor.example.com|robot$byclaw|change-me|https|false'
K3S_PRIVATE_REGISTRIES=
K3S_DATA_DIR=/data/rancher/k3s
K3S_KUBELET_ROOT=/data/kubelet
# 主节点可承载工作负载，但预留更多 kube/system 资源，降低其业务承载比例。
K3S_SERVER_KUBE_RESERVED=cpu=1000m,memory=2Gi,ephemeral-storage=5Gi
K3S_SERVER_SYSTEM_RESERVED=cpu=1000m,memory=2Gi,ephemeral-storage=5Gi
K3S_AGENT_KUBE_RESERVED=cpu=500m,memory=1Gi,ephemeral-storage=3Gi
K3S_AGENT_SYSTEM_RESERVED=cpu=500m,memory=1Gi,ephemeral-storage=3Gi
K3S_EVICTION_HARD='memory.available<500Mi,nodefs.available<10%'

# 逗号分隔。第一台 server 执行 cluster-init，其余 server 加入 embedded etcd。
# K3S_*_HOSTS 是 SSH 入口，可填公网 IP。
K3S_SERVER_HOSTS=node-1,node-2,node-3
# worker/agent 可为空；沙箱建议放到 agent 或独立 server+worker 节点。
K3S_AGENT_HOSTS=node-4,node-5,node-6
# 可选：公网 SSH IP 到内网 VPC IP 的映射。设置后 k3s 使用内网 IP 注册节点。
# 同时用于自定义节点名（仅小写字母/数字/连字符，不能用下划线）：
# server -> byclaw-master-{末段}，agent -> byclaw-node-{末段}
# 例：10.0.0.156 -> byclaw-master-156 / byclaw-node-156
K3S_CUSTOM_NODE_NAMES=true
K3S_NODE_NAME_MASTER_PREFIX=byclaw-master
K3S_NODE_NAME_WORKER_PREFIX=byclaw-node
K3S_NODE_INTERNAL_IPS=node-1=10.0.0.11,node-2=10.0.0.12,node-3=10.0.0.13,node-4=10.0.0.14,node-5=10.0.0.15,node-6=10.0.0.16
# 内网模式下勿配置公网 NodeExternalIP。仅 K3S_CLUSTER_INTERNAL_ONLY=false 时生效。
K3S_NODE_EXTERNAL_IPS=
K3S_SSH_USER=root
K3S_SSH_PORT=22
K3S_SSH_PASSWORD=

# 可选：保留兼容旧变量名。
K3S_SERVER_USER=${K3S_SSH_USER}
K3S_SERVER_PORT=${K3S_SSH_PORT}
K3S_SERVER_PASSWORD=${K3S_SSH_PASSWORD}

# 节点池标签（与 BatchSandbox 模板 nodeSelector 对应）。
# 显式指定 host 归属；未命中的节点会打到 general。
K3S_NODE_POOL_GENERAL=sandbox-general
K3S_NODE_POOL_BROWSER=sandbox-browser
K3S_NODE_POOL_HEAVY=sandbox-heavy
K3S_NODE_POOL_GENERAL_HOSTS=node-1,node-2,node-3
K3S_NODE_POOL_BROWSER_HOSTS=node-4,node-5
K3S_NODE_POOL_HEAVY_HOSTS=node-6

# ---------- Namespaces ----------
NS_SERVICE=by-service
NS_MIDDLEWARE=by-middleware
NS_SANDBOX=by-sandbox
NS_MONITORING=monitoring

# ---------- 对外暴露 ----------
# ServiceLB 仅在指定节点监听公开端口；默认由 deploy.sh 自动选择 control-plane 主节点。
# BYCLAW_K3S_SERVICELB_NODE_NAME=byclaw-master-156
BYCLAW_K3S_SERVICELB_EXCLUSIVE=true

# ---------- 镜像 ----------
IMAGE_FE=ghcr.io/beyonai/byclaw/byclaw-fe:main
IMAGE_BE=ghcr.io/beyonai/byclaw/byclaw-be:main
IMAGE_QA=ghcr.io/beyonai/byclaw/byclaw-qa:main
IMAGE_DATA=ghcr.io/beyonai/byclaw/byclaw-data:main
IMAGE_REDIS=ghcr.io/beyonai/byclaw/byclaw-redis:main
IMAGE_OPENGAUSS=ghcr.io/beyonai/byclaw/byclaw-opengauss:main
IMAGE_OPENCLAW=ghcr.io/beyonai/byclaw/byclaw-openclaw:main
# 使用固定 tag 反复推送业务镜像时必须重新拉取，默认 Always 避免 update 后仍跑旧镜像。
BYCLAW_SERVICE_IMAGE_PULL_POLICY=Always
# update 成功后清理 containerd 里因复用 tag 产生的 repo@sha256 旧引用。
# 默认从 IMAGE_BE/IMAGE_FE/IMAGE_QA/IMAGE_DATA 推导仓库；需要收窄时可显式配置逗号分隔仓库。
BYCLAW_K3S_PRUNE_EMPTY_IMAGES_ON_UPDATE=true
BYCLAW_K3S_PRUNE_DANGLING_IMAGES=true
# BYCLAW_K3S_PRUNE_IMAGE_REPOS=192.168.0.158:8080/byclaw/byclaw-be,192.168.0.158:8080/byclaw/byclaw-fe
# 私有 Harbor 时设置前缀，并将 opensandbox/* 镜像同步到 Harbor（见 README）
# BYCLAW_IMAGE_REGISTRY=192.168.0.158:8080
# 版本以 opensandbox-group/OpenSandbox main 分支 Helm values 为准（各组件版本号相互独立）：
#   controller chart 0.2.0  → controller:v0.2.0
#   server chart            → server:v0.1.14, execd:v1.0.18, egress:v1.0.12, ingress:v1.0.7
IMAGE_SANDBOX_SERVER=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/server:v0.1.14
IMAGE_SANDBOX_CONTROLLER=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/controller:v0.2.0
IMAGE_SANDBOX_EXECD=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/execd:v1.0.18
IMAGE_SANDBOX_EGRESS=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/egress:v1.0.12
# OpenSandbox 创建的沙箱业务容器镜像拉取策略。复用 IMAGE_OPENCLAW tag 时，线上建议设置 Always。
OPENSANDBOX_SANDBOX_IMAGE_PULL_POLICY=IfNotPresent
BYCLAW_BE_REPLICAS=1
BYCLAW_FE_REPLICAS=1
BYCLAW_QA_REPLICAS=1
BYCLAW_DATA_REPLICAS=1
OPENSANDBOX_REPLICAS=1
OPENSANDBOX_HPA_MIN=1

# ---------- 业务服务运行参数 ----------
BE_DOMAINNAME=ByaiService
QA_DOMAINNAME=byclaw-qa-manager
DATACLOUD_DOMAINNAME=byclaw-datacloud
BE_SERVER_PORT=8086
BE_WS_PORT=8082
BYCLAW_QA_PORT=8000
DATACLOUD_PORT=8088
DATACLOUD_DATA_SERVICE_PORT=8088
BYCLAW_QA_AGENT_DATA_PATH=agent_data
BYCLAW_QA_KB_FETCH_CACHE_TTL_SECONDS=86400
BYCLAW_QA_KB_FETCH_CACHE_CLEANUP_INTERVAL_SECONDS=600
BYCLAW_QA_KB_MINIO_BUCKET=knowledge-base
BYCLAW_QA_KB_MINIO_MARKDOWN_BUCKET=knowledge-base-markdown
BYCLAW_QA_BYAI_WORKER_ID=instant-search-worker-1
DATACLOUD_START_MCP_SERVICE=true
DATACLOUD_START_GATEWAY_WORKER=true
DATACLOUD_GATEWAY_WORKER_ID=BYCLAW_DATA
DATACLOUD_GATEWAY_CONSUMER_GROUP=datacloud

# ---------- OpenSandbox ----------
# K8s runtime 需先装 controller（CRD + operator），再 deploy opensandbox-server
OPENSANDBOX_CONTROLLER_CHART_VERSION=0.2.0
OPENSANDBOX_CONTROLLER_NAMESPACE=opensandbox-system
# 默认在线下载 controller chart 到 /tmp/byclaw-opensandbox-controller/
# OPENSANDBOX_CONTROLLER_CHART_URL=https://github.com/alibaba/OpenSandbox/releases/download/helm/opensandbox-controller/0.2.0/opensandbox-controller-0.2.0.tgz
# OPENSANDBOX_CONTROLLER_CHART_FILE=/tmp/opensandbox-controller-0.2.0.tgz
# 节点无 helm 时自动下载到 /tmp/byclaw-opensandbox-controller/helm-v3.14.4
BYCLAW_K3S_AUTO_INSTALL_HELM=true
# HELM_VERSION=3.14.4
# HELM_DOWNLOAD_BASE=https://get.helm.sh
OPENSANDBOX_API_KEY=change-me
OPENSANDBOX_API_PORT=9005
OPENSANDBOX_WORKLOAD_NAMESPACE=by-service
# Use the FE ingress HTTP entrypoint. Replace the IP with a domain later if needed,
# for example: sandbox.example.com/v1/sandboxes. OpenSandbox forbids a scheme here.
OPENSANDBOX_GATEWAY_ADDRESS=master-public-ip.example.com/v1/sandboxes
OPENSANDBOX_ROUTE_MODE=uri
OPENSANDBOX_ENDPOINT_SCHEME=http
OPENSANDBOX_TLS_SECRET=sandbox-wildcard-tls
GENERATE_STATIC_SANDBOX_WILDCARD_INGRESS=false
OPENSANDBOX_VOLUME_DEFAULT_SIZE=20Gi
# Comma-separated hostPath prefixes OpenSandbox may mount for ByClaw workspaces.
# Defaults to FILE_STORAGE_LOCAL_PATH/BYCLAW_SANDBOX_FILE_VOLUME_ROOT.
OPENSANDBOX_ALLOWED_HOST_PATHS=/mnt/byclaw-workspace
OPENSANDBOX_NODE_POOL=sandbox-general

# ---------- 存储（Longhorn 分布式，弃用 NFS / minio-mount / rclone）----------
STORAGE_CLASS=longhorn
WORKSPACE_PVC_NAME=byclaw-workspace
WORKSPACE_PVC_SIZE=500Gi
LONGHORN_VERSION=v1.6.2
LONGHORN_NAMESPACE=longhorn-system
LONGHORN_DATA_PATH=/data/longhorn
LONGHORN_REPLICA_COUNT=3
# 默认与手动安装一致：kubectl apply -f LONGHORN_MANIFEST_URL
# LONGHORN_MANIFEST_URL=https://raw.githubusercontent.com/longhorn/longhorn/v1.6.2/deploy/longhorn.yaml
# LONGHORN_MANIFEST_FILE=/tmp/longhorn.yaml
# LONGHORN_MANIFEST_CACHE=true
# LONGHORN_MANIFEST_CACHE_DIR=/tmp/byclaw-longhorn
BYCLAW_DEPLOY_STORAGE=longhorn
FILE_STORAGE_TYPE=file
FILE_STORAGE_MINIO_MOUNT_ENABLED=false
BYCLAW_SANDBOX_VOLUME_BACKEND=file
# file-type 描述 BE 进程看到的挂载类型；K8s 挂 Longhorn PVC 后用 bind
BYCLAW_SANDBOX_FILE_VOLUME_ROOT=/mnt/byclaw-workspace
BYCLAW_SANDBOX_FILE_VOLUME_TYPE=bind
FILE_STORAGE_LOCAL_PATH=/mnt/byclaw-workspace

# ---------- Ingress / 业务入口 ----------
BYCLAW_INGRESS_HOST=byclaw.example.com
SANDBOX_INGRESS_HOST=sandbox.example.com
BYCLAW_TLS_SECRET=

# ---------- 动态 ResourceQuota 比例（总和不超过 100 - SYSTEM_RESERVE）----------
QUOTA_SYSTEM_RESERVE_PERCENT=15
QUOTA_SANDBOX_PERCENT=60
QUOTA_MIDDLEWARE_PERCENT=10
QUOTA_SERVICE_PERCENT=15
SANDBOX_XS_ONLINE_TARGET=100
SANDBOX_WORKLOAD_POD_BUFFER=40

# ---------- ByClaw 沙箱接入 ----------
BYCLAW_SANDBOX_ENABLE=true
BYCLAW_SANDBOX_BASE_URL=http://opensandbox-server.by-sandbox.svc.cluster.local:9005
BYCLAW_SANDBOX_API_KEY=change-me
BYCLAW_SANDBOX_ENDPOINT_SCHEME=https
BYCLAW_SANDBOX_PROFILE_ENABLED=true
BYCLAW_SANDBOX_TIER_AUTOSCALE_ENABLED=true

# ---------- 数据库 / Redis（by-middleware）----------
DB_HOST=opengauss.by-middleware.svc.cluster.local
DB_PORT=5432
DB_TYPE=postgresql
DB_USER=gaussdb
DB_PASS=change-me
DB_DATABASE=postgres
DB_SCHEMA=byai
OPENGAUSS_PUBLIC_ENABLED=false
OPENGAUSS_PUBLIC_SERVICE_NAME=opengauss-public
OPENGAUSS_PUBLIC_PORT=5432
REDIS_HOST=redis.by-middleware.svc.cluster.local
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

# ---------- 监控与告警 webhook ----------
MONITORING_ENABLED=true
ALERTMANAGER_WEBHOOK_URL=http://byclaw-be.by-service.svc.cluster.local:8086/byaiService/sandbox/autoscale/alerts
BYAI_ACCESS_URLPATTERNS=/byaiService/sandbox/autoscale/alerts,/sandbox/autoscale/alerts
MONITORING_EXTERNAL_BASE_URL=http://${K3S_API_HOST}
MONITORING_PROMETHEUS_RETENTION=15d
MONITORING_PROMETHEUS_PVC_SIZE=50Gi
MONITORING_GRAFANA_PVC_SIZE=10Gi
IMAGE_PROMETHEUS=quay.io/prometheus/prometheus:v2.55.1
IMAGE_NODE_EXPORTER=quay.io/prometheus/node-exporter:v1.8.2
IMAGE_KUBE_STATE_METRICS=m.daocloud.io/registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.14.0
IMAGE_GRAFANA=grafana/grafana:11.3.1
# Optional: set this only in a private env file. If empty, deploy generates or reuses the Secret.
# MONITORING_GRAFANA_ADMIN_PASSWORD=change-me

# ---------- 部署行为 ----------
# 重跑安装前清理残留进程及 /tmp、/var/tmp 下的 k3s-install.* 目录与安装包
BYCLAW_K3S_CLEAN_STALE_PROCESSES=true
BYCLAW_K3S_INSTALL_K3S=false
BYCLAW_K3S_INSTALL_LONGHORN=true
BYCLAW_K3S_INSTALL_OPENSANDBOX_CONTROLLER=true
BYCLAW_K3S_INSTALL_MONITORING=true
